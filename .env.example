# ---------------------------------------------------------------
# MediStock Intelligence - environment configuration
# Copy this file to .env and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------
APP_NAME="MediStock Intelligence"
APP_ENV=production          # production | development
APP_DEBUG=false             # true shows detailed errors (development only)
APP_URL=http://localhost/MediStock
APP_TIMEZONE=UTC          # e.g. Africa/Dar_es_Salaam, Europe/London
APP_KEY=                    # random 64-char hex; generate with: php bin/console key:generate

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medistock
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=medistock_sid
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
SESSION_SECURE_COOKIE=auto  # auto | true | false

# Google Gemini (server-side only, never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
