{
    "name": "medistock/intelligence",
    "description": "MediStock Intelligence - Smart Hospital Inventory and Resource Management System",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^5.6",
        "chillerlan/php-qrcode": "^5.0",
        "picqer/php-barcode-generator": "^3.2",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": [ "app/Helpers/functions.php" ]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.2.12" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
