Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Serve real asset files directly, send everything else to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
